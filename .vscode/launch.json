{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Your own server",
            "request": "launch",
            "type": "al",
            "environmentType": "OnPrem",
            "server": "http://localhost:8080/BC140/",
            "serverInstance": "BC140",
            "authentication": "Windows",
            "schemaUpdateMode": "Synchronize", //after a schema update, the database will be recreated if "recreate" is applied. Use with caution! synchronize to reflect the current changes
            "startupObjectId": 22,
            "startupObjectType": "Page",
            "breakOnError": "All",
            "launchBrowser": true,
            "enableLongRunningSqlStatements": true,
            "enableSqlInformationDebugger": true,
            "tenant": "default",
            "usePublicURLFromServer": true
        }
    ]
}